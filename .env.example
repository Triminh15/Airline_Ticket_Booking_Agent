# ==============================================================================
# HƯỚNG DẪN: Copy file này thành .env ở cùng thư mục và điền API Key thực tế của bạn.
# ==============================================================================

# 1. Cấu hình Groq API (Mặc định khuyên dùng - Tốc độ cao, Free tier lớn)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Một số model Groq khác có thể dùng:
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. Cấu hình Google Gemini (Tùy chọn dự phòng)
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_MODEL=gemini-1.5-flash

# 3. Cấu hình OpenAI-compatible (Nếu dùng endpoint tương thích OpenAI)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini